# ==========================================
# Personalix OS Environment Configuration
# ==========================================

# Environment Mode: development | production | test
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Default is SQLite for instant zero-dependency local setup.
# For production PostgreSQL with pgvector, use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personalix_db
DATABASE_URL=sqlite+aiosqlite:///./personalix.db

# Redis Configuration (Optional - fallback to memory if not set)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
# Generate a strong 256-bit secret key in production: openssl rand -hex 32
JWT_SECRET=personalix-super-secure-production-ready-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Providers (At least one recommended; heuristic fallback works without keys)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Default AI Provider: auto | openai | anthropic | gemini | fallback
DEFAULT_AI_PROVIDER=auto

# RAG & Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Frontend Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Personalix OS
